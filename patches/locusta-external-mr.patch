+#[test]
+fn external_user_mr_descriptor_preserves_inline_header_and_direction() {
+    let mut h = TestHarness::new(64, 1024 * 1024);
+    // Mock relay only inspects descriptors; no DMA is issued in this test.
+    let external = unsafe { RegisteredBuffer::new(0x1234_0000, 65536, 42, 43) };
+    for get in [false, true] {
+        let header = [0x5a; 208];
+        let mut batch = h.client.batch();
+        let _response = if get {
+            batch.call_get_registered(7, &header, &external)
+        } else {
+            batch.call_put_registered(7, &header, &external)
+        }.unwrap();
+        drop(batch);
+        let slot = h.client.req_queue.try_dequeue().unwrap();
+        assert_eq!(slot.external_dma(), Some((0x1234_0000, 42, 43)));
+        assert_eq!(slot.dma_len, 65536);
+        assert_eq!(slot.small_req_len, 208);
+        assert_eq!(slot.small_req_inline[..208], header);
+        assert_eq!(slot.flags & RequestFlags::HAS_DMA_READ.bits() != 0, get);
+        assert_eq!(slot.flags & RequestFlags::HAS_DMA_WRITE.bits() != 0, !get);
+        assert_eq!(h.client.pending[slot.req_id as usize].has_dma_read, get);
+    }
+}
+
+#[test]
+fn external_user_mr_oversize_header_has_no_pending_side_effect() {
+    let mut h = TestHarness::new(64, 1024 * 1024);
+    let external = unsafe { RegisteredBuffer::new(0x1234_0000, 65536, 42, 43) };
+    assert!(h.client.batch().call_get_registered(0, &[0; 209], &external).is_err());
+    assert!(h.client.pending.is_empty());
+    assert!(h.client.req_queue.try_dequeue().is_none());
+}
