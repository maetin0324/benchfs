 impl Pd {
+    /// Register an explicit ODP range. Kernel MMU notifiers invalidate
+    /// translations on unmap/remap, so this MR may be cached across frees.
+    ///
+    /// # Safety
+    /// The caller must keep the virtual range valid with the required access
+    /// during each DMA operation, and retain this MR until DMA completes.
+    /// Between operations the range may be unmapped or reused. Never use the
+    /// keys to access freed memory. ODP support is required; no pinned fallback.
+    pub unsafe fn register_odp(&self, addr: *mut u8, len: usize, writable: bool)
+        -> io::Result<MemoryRegion>
+    {
+        let access = if writable {
+            AccessFlags::ON_DEMAND | AccessFlags::LOCAL_WRITE | AccessFlags::REMOTE_WRITE
+        } else { AccessFlags::ON_DEMAND };
+        // ODP's MMU notifier lifetime is stronger than ordinary register().
+        unsafe { self.register(addr, len, access) }
+    }
+
     /// Register a memory region with the HCA.
     ///
     /// Registers a memory buffer starting at `addr` with size `len` bytes.
@@ -217,6 +235,53 @@
     pub fn is_empty(&self) -> bool {
         self.len() == 0
     }
+
+    /// Synchronously populate the ODP translations of the whole region
+    /// (`ibv_advise_mr` prefetch with FLUSH), so the first DMA does not take
+    /// an HCA page fault. A responder-side fault is answered with an RNR NAK
+    /// and stalls the peer for the QP's `min_rnr_timer`.
+    ///
+    /// Best effort: on error the MR stays valid and faults on demand.
+    /// Translations dropped later by an MMU invalidation are also re-faulted
+    /// on demand; this is only an initial warm-up.
+    pub fn prefetch_odp(&self, writable: bool) -> io::Result<()> {
+        let unsupported = || io::Error::from(io::ErrorKind::Unsupported);
+        let length = u32::try_from(self.len()).map_err(|_| unsupported())?;
+        // `ibv_advise_mr` is a static inline in verbs.h; this is its body.
+        unsafe {
+            let pd = self._pd.as_ptr();
+            let ctx = (*pd).context;
+            // __VERBS_ABI_IS_EXTENDED
+            if (*ctx).abi_compat as usize != usize::MAX {
+                return Err(unsupported());
+            }
+            let offset = std::mem::offset_of!(mlx5_sys::verbs_context, context);
+            let vctx = (ctx as *mut u8).sub(offset) as *mut mlx5_sys::verbs_context;
+            let op_offset = std::mem::offset_of!(mlx5_sys::verbs_context, advise_mr);
+            if (*vctx).sz < std::mem::size_of::<mlx5_sys::verbs_context>() - op_offset {
+                return Err(unsupported());
+            }
+            let advise = (*vctx).advise_mr.ok_or_else(unsupported)?;
+            let advice = if writable {
+                mlx5_sys::ib_uverbs_advise_mr_advice_IB_UVERBS_ADVISE_MR_ADVICE_PREFETCH_WRITE
+            } else {
+                mlx5_sys::ib_uverbs_advise_mr_advice_IB_UVERBS_ADVISE_MR_ADVICE_PREFETCH
+            };
+            let mut sge = mlx5_sys::ibv_sge {
+                addr: self.addr() as u64,
+                length,
+                lkey: self.lkey(),
+            };
+            let rc = advise(
+                pd,
+                advice,
+                mlx5_sys::ib_uverbs_advise_mr_flag_IB_UVERBS_ADVISE_MR_FLAG_FLUSH,
+                &mut sge,
+                1,
+            );
+            if rc == 0 { Ok(()) } else { Err(io::Error::from_raw_os_error(rc)) }
+        }
+    }
 }
 
